<?xml version="1.0"?>
<!--
  A minimal arm with a parallel-jaw gripper, for the URDF-to-manifest example.
  The numbers here are the same kind a real URDF (or a driver) already carries:
  per-joint effort, velocity, and position limits. URML consumes the gripper
  finger joint's effort limit as a grasp-force cap. Illustrative values, not a
  specific product. For clemense/yourdfpy#69 (the liburdf JSON-emission thread).
-->
<robot name="simple_arm">
  <link name="base_link"/>
  <link name="shoulder_link"/>
  <link name="forearm_link"/>
  <link name="gripper_base"/>
  <link name="left_finger"/>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="45.0" velocity="2.0" lower="-2.967" upper="2.967"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="shoulder_link"/>
    <child link="forearm_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="30.0" velocity="2.5" lower="-1.745" upper="1.745"/>
  </joint>

  <joint name="wrist_to_gripper" type="fixed">
    <parent link="forearm_link"/>
    <child link="gripper_base"/>
  </joint>

  <!-- The parallel-jaw finger. Its effort limit is the grasp-force cap URML consumes. -->
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <axis xyz="1 0 0"/>
    <limit effort="185.0" velocity="0.15" lower="0.0" upper="0.025"/>
  </joint>
</robot>
