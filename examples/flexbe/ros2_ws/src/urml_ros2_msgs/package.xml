<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>urml_ros2_msgs</name>
  <version>0.1.0</version>
  <description>
    ROS 2 action interface for URML — the ExecuteURML action that exposes
    URML's validate-before-actuate pipeline to behavior engines (FlexBE, BT).
    Part of the URML FlexBE worked example (RFC-0474).
  </description>
  <maintainer email="greenvh@gmail.com">URML Maintainers</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://urml.dev</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>action_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
